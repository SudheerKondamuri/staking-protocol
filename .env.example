# Private key for the deployer wallet on the local Hardhat network
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Deployed contract addresses (to be set after running deployments)
NEXT_PUBLIC_STAKING_CONTRACT_ADDRESS=
